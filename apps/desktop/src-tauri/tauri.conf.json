{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plastiq",
  "version": "0.1.0",
  "identifier": "com.layerdynamics.plastiq",
  "build": {
    "beforeDevCommand": "pnpm -C ../plastiq dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -C ../plastiq build",
    "frontendDist": "../../plastiq/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plastiq",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../scripts/dev-services.sh": "orchestrator/scripts/dev-services.sh",
      "../../../services/reconstruct/app": "orchestrator/services/reconstruct/app",
      "../../../services/reconstruct/environment.yml": "orchestrator/services/reconstruct/environment.yml",
      "../../../services/reconstruct/pyproject.toml": "orchestrator/services/reconstruct/pyproject.toml",
      "../../../services/capture/app": "orchestrator/services/capture/app",
      "../../../services/capture/environment.yml": "orchestrator/services/capture/environment.yml",
      "../../../services/nerf/app": "orchestrator/services/nerf/app",
      "../../../services/nerf/environment.yml": "orchestrator/services/nerf/environment.yml",
      "../../../services/nerf/pyproject.toml": "orchestrator/services/nerf/pyproject.toml",
      "../../../services/nurbs/app": "orchestrator/services/nurbs/app",
      "../../../services/nurbs/environment.yml": "orchestrator/services/nurbs/environment.yml",
      "../../../services/nurbs/pyproject.toml": "orchestrator/services/nurbs/pyproject.toml",
      "../../../services/photogrammetry/app": "orchestrator/services/photogrammetry/app",
      "../../../services/photogrammetry/environment.yml": "orchestrator/services/photogrammetry/environment.yml",
      "../../../services/photogrammetry/pyproject.toml": "orchestrator/services/photogrammetry/pyproject.toml"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
